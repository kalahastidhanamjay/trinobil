    "@types/node": "20",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@vitejs/plugin-react": "4",
    "openapi-typescript": "7",
    "tailwindcss": "4",
    "typescript": "5",
    "vite": "5"
  }
